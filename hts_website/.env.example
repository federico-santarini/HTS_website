# Copia questo file in .env (che non è versionato) e compila i valori.

# Chiave segreta di Django. Obbligatoria. In produzione: un valore lungo e casuale.
SECRET_KEY=change-me

# True solo in sviluppo. Se la variabile manca, vale False.
DEBUG=True

# Indirizzo della pubblicazione, usato per il link in navbar. Vuoto = link nascosto.
# In locale: http://publication.localhost:8000
PUBLICATION_URL=https://publication.example.com

# Database Postgres
PGDATABASE=hts_dev
PGUSER=postgres
PGPASSWORD=change-me
PGHOST=localhost
PGPORT=5432
