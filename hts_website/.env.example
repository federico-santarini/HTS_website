# Copia questo file in .env (che non è versionato) e compila i valori.

# Chiave segreta di Django. Obbligatoria. In produzione: un valore lungo e casuale.
SECRET_KEY=change-me

# True solo in sviluppo. Se la variabile manca, vale False.
DEBUG=True

# Indirizzo della pubblicazione, usato per il link in navbar. Vuoto = link nascosto.
# In locale: http://publication.localhost:8000
PUBLICATION_URL=https://publication.example.com

# Database Postgres
PGDATABASE=hts_dev
PGUSER=postgres
PGPASSWORD=change-me
PGHOST=localhost
PGPORT=5432

# --- Solo online (Railway). In locale si possono lasciare fuori. Spiegazione completa: README, "Deploy su Railway".
# Indirizzi ammessi (separati da virgola). In sviluppo (DEBUG=True) non serve: vale qualsiasi indirizzo.
# ALLOWED_HOSTS=dominio.it,www.dominio.it,publication.dominio.it
# True = intestazione "noindex" su ogni risposta (i motori di ricerca non indicizzano il sito).
# NOINDEX=True
# Immagini su Cloudflare R2 (se manca R2_BUCKET_NAME le immagini restano sul disco locale).
# R2_BUCKET_NAME=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=pub-xxxx.r2.dev
# Account admin creato al deploy da "python manage.py ensure_superuser" (se non esiste già).
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=
